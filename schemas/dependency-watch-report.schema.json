{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency Watch Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "blocking_dependencies", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": [
        "dependencies_total",
        "dependencies_blocking",
        "productization_ready",
        "p0_risks",
        "execution_status"
      ],
      "properties": {
        "dependencies_total": {"type": "integer"},
        "dependencies_blocking": {"type": "integer"},
        "productization_ready": {"type": "boolean"},
        "p0_risks": {"type": "integer"},
        "execution_status": {"type": "string"}
      }
    },
    "blocking_dependencies": {"type": "array", "items": {"type": "object"}},
    "actions": {"type": "array", "items": {"type": "string"}}
  }
}
