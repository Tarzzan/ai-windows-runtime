{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Root Cause Summary Artifact",
  "type": "object",
  "required": [
    "artifact_version",
    "generated_at",
    "summary",
    "root_cause_clusters",
    "scenarios",
    "actions"
  ],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": [
        "scenario_count",
        "total_gaps",
        "high_severity_gaps",
        "p0_linked_proposals",
        "top_root_causes"
      ],
      "properties": {
        "scenario_count": {"type": "integer"},
        "total_gaps": {"type": "integer"},
        "high_severity_gaps": {"type": "integer"},
        "p0_linked_proposals": {"type": "integer"},
        "top_root_causes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "root_cause_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "count", "hint"],
        "properties": {
          "category": {"type": "string"},
          "count": {"type": "integer"},
          "hint": {"type": "string"}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "gap_count",
          "high_severity_gaps",
          "p0_linked_proposals",
          "top_categories",
          "top_gaps"
        ],
        "properties": {
          "label": {"type": "string"},
          "gap_count": {"type": "integer"},
          "high_severity_gaps": {"type": "integer"},
          "p0_linked_proposals": {"type": "integer"},
          "top_categories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["category", "count", "hint"],
              "properties": {
                "category": {"type": "string"},
                "count": {"type": "integer"},
                "hint": {"type": "string"}
              }
            }
          },
          "top_gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "category", "severity", "priority", "summary"],
              "properties": {
                "id": {"type": "string"},
                "category": {"type": "string"},
                "severity": {"type": "string"},
                "priority": {"type": "string"},
                "summary": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}

