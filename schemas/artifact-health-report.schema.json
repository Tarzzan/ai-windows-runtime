{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Health Report",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "reports", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["required_reports", "healthy_reports", "missing_reports", "health_ratio"],
      "properties": {
        "required_reports": {"type": "integer"},
        "healthy_reports": {"type": "integer"},
        "missing_reports": {"type": "integer"},
        "health_ratio": {"type": "number"}
      }
    },
    "reports": {"type": "array", "items": {"type": "object"}},
    "actions": {"type": "array", "items": {"type": "string"}}
  }
}
