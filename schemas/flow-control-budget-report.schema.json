{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow Control Budget Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["flow_control_score", "flow_control_mode", "scope_rebalance", "capacity_buffer_score", "execution_reserve"],
      "properties": {
        "flow_control_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "flow_control_mode": {"type": "string", "enum": ["tight", "managed", "open"]}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
