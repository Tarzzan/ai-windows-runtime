{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Control Recommendation Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["control_mode", "temperature", "confidence_band", "pressure_level", "policy_status"],
      "properties": {
        "control_mode": {"type": "string", "enum": ["strict", "stabilize", "controlled", "accelerate"]},
        "temperature": {"type": "string"},
        "confidence_band": {"type": "string"},
        "pressure_level": {"type": "string"},
        "policy_status": {"type": "string"}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
