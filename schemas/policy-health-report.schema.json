{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy Health Report",
  "type": "object",
  "required": [
    "artifact_version",
    "policy_path",
    "policy_profile",
    "active_policy_sha256",
    "lockfile_path",
    "lockfile_exists",
    "lockfile_sync",
    "config_valid"
  ],
  "properties": {
    "artifact_version": { "type": "string" },
    "policy_path": { "type": "string" },
    "policy_profile": { "type": "string" },
    "active_policy_sha256": { "type": "string" },
    "lockfile_path": { "type": "string" },
    "lockfile_exists": { "type": "boolean" },
    "lockfile_sync": { "type": "boolean" },
    "config_valid": { "type": "boolean" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
