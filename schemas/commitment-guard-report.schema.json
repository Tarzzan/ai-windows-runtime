{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commitment Guard Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["commitment_guard", "admission_window", "p0_entries", "policy_status"],
      "properties": {
        "commitment_guard": {"type": "string", "enum": ["strict", "moderate", "adaptive"]},
        "admission_window": {"type": "string", "enum": ["restricted", "controlled", "open"]},
        "p0_entries": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
