{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Packet Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "missing", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": [
        "packet_ready",
        "launch_status",
        "release_decision",
        "bundle_files",
        "bundle_missing",
        "stakeholder_delivery_status",
        "policy_config_valid",
        "policy_lockfile_sync",
        "policy_compliance_level",
        "release_policy_status",
        "release_policy_failures"
      ],
      "properties": {
        "packet_ready": {"type": "boolean"},
        "launch_status": {"type": "string"},
        "release_decision": {"type": "string"},
        "bundle_files": {"type": "integer"},
        "bundle_missing": {"type": "integer"},
        "stakeholder_delivery_status": {"type": "string"},
        "policy_config_valid": {"type": "boolean"},
        "policy_lockfile_sync": {"type": "boolean"},
        "policy_compliance_level": {
          "type": "string",
          "enum": ["compliant", "degraded", "non_compliant"]
        },
        "release_policy_status": {"type": "string", "enum": ["pass", "fail", "missing"]},
        "release_policy_failures": {"type": "integer"}
      }
    },
    "missing": {"type": "array", "items": {}},
    "actions": {"type": "array", "items": {"type": "string"}}
  }
}
