{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intake Guard Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["intake_guard", "bandwidth_mode", "policy_status", "priority_corridor"],
      "properties": {
        "intake_guard": {"type": "string", "enum": ["strict", "moderate", "open"]}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
