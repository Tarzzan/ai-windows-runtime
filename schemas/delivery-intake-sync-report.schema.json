{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Intake Sync Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["delivery_intake_sync", "risk_budget_mode", "admission_window", "cadence"],
      "properties": {
        "delivery_intake_sync": {"type": "string", "enum": ["blocked", "aligned", "expanding"]},
        "risk_budget_mode": {"type": "string", "enum": ["conservative", "balanced", "aggressive"]}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
