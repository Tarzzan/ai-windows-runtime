{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transition Readiness Index Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["transition_readiness_score", "transition_readiness_band", "scope_transition_gate", "delivery_stress_score", "policy_compliance_level"],
      "properties": {
        "transition_readiness_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "transition_readiness_band": {"type": "string", "enum": ["blocked", "watch", "ready"]}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
