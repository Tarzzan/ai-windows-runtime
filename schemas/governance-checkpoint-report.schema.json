{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governance Checkpoint Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "status", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "status": {"type": "string"},
    "summary": {
      "type": "object",
      "required": [
        "window_status",
        "hotfix_plan_mode",
        "missing_reports",
        "catalog_items",
        "policy_config_valid",
        "policy_lockfile_sync",
        "policy_compliance_level"
      ],
      "properties": {
        "window_status": {"type": "string"},
        "hotfix_plan_mode": {"type": "string"},
        "missing_reports": {"type": "integer"},
        "catalog_items": {"type": "integer"},
        "policy_config_valid": {"type": "boolean"},
        "policy_lockfile_sync": {"type": "boolean"},
        "policy_compliance_level": {
          "type": "string",
          "enum": ["compliant", "degraded", "non_compliant"]
        }
      }
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  }
}
