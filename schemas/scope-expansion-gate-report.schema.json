{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scope Expansion Gate Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["scope_expansion_gate", "intake_expansion_policy", "scope_unlock_gate", "release_policy_status"],
      "properties": {
        "scope_expansion_gate": {"type": "string", "enum": ["closed", "guarded", "open"]},
        "intake_expansion_policy": {"type": "string", "enum": ["hold", "stage", "expand"]},
        "scope_unlock_gate": {"type": "string", "enum": ["locked", "guarded", "unlocked"]}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
