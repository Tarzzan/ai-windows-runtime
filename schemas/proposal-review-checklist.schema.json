{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal Review Checklist Artifact",
  "type": "object",
  "required": [
    "artifact_version",
    "generated_at",
    "ready_for_approval",
    "summary",
    "items",
    "actions"
  ],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "ready_for_approval": {"type": "boolean"},
    "summary": {
      "type": "object",
      "required": [
        "proposal_count",
        "total_items",
        "pass_items",
        "warn_items",
        "fail_items",
        "todo_items",
        "required_failures"
      ],
      "properties": {
        "proposal_count": {"type": "integer"},
        "total_items": {"type": "integer"},
        "pass_items": {"type": "integer"},
        "warn_items": {"type": "integer"},
        "fail_items": {"type": "integer"},
        "todo_items": {"type": "integer"},
        "required_failures": {"type": "integer"}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "required", "status", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "required": {"type": "boolean"},
          "status": {"type": "string"},
          "evidence": {"type": "string"},
          "proposal_gap_id": {"type": "string"}
        }
      }
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  }
}

