{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commitment Pacing Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["commitment_mode", "admission_state", "p0_backlog_items", "bandwidth_mode"],
      "properties": {
        "commitment_mode": {"type": "string", "enum": ["stabilize", "paced", "expand"]},
        "admission_state": {"type": "string", "enum": ["gated", "selective", "open"]},
        "p0_backlog_items": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
