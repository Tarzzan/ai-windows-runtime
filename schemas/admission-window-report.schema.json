{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admission Window Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["admission_window", "scope_budget_mode", "admission_state", "p0_focus_items"],
      "properties": {
        "admission_window": {"type": "string", "enum": ["restricted", "controlled", "open"]},
        "scope_budget_mode": {"type": "string", "enum": ["tight", "balanced", "flexible"]}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
