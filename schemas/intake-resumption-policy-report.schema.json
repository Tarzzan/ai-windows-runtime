{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intake Resumption Policy Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["intake_resumption_policy", "scope_reentry_readiness_band", "intake_transition_policy", "delivery_temperature"],
      "properties": {
        "intake_resumption_policy": {"type": "string", "enum": ["hold", "stage", "resume"]},
        "scope_reentry_readiness_band": {"type": "string", "enum": ["blocked", "watch", "ready"]}
      },
      "additionalProperties": true
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
