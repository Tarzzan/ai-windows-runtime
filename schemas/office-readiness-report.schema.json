{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Office Readiness Report Artifact",
  "type": "object",
  "required": ["artifact_version", "generated_at", "status", "summary", "actions"],
  "properties": {
    "artifact_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "status": {"type": "string"},
    "summary": {
      "type": "object",
      "required": [
        "bootstrap_coverage",
        "unresolved_p0_items",
        "replay_stability",
        "com_failures",
        "registry_failures",
        "installer_failures",
        "installer_has_errors",
        "bootstrap_phase_events",
        "bootstrap_phase_errors"
      ],
      "properties": {
        "bootstrap_coverage": {"type": "number"},
        "unresolved_p0_items": {"type": "integer"},
        "replay_stability": {"type": "string"},
        "com_failures": {"type": "integer"},
        "registry_failures": {"type": "integer"},
        "installer_failures": {"type": "integer"},
        "installer_has_errors": {"type": "boolean"},
        "bootstrap_phase_events": {"type": "integer"},
        "bootstrap_phase_errors": {"type": "integer"}
      }
    },
    "actions": {"type": "array", "items": {"type": "string"}}
  }
}
